---
/**
 * Вторичный источник: агрегатор или блог приёмного консультанта.
 * Помечается ромбом — такие цифры нужно перепроверять по первичным
 * документам. Ссылка необязательна: если она есть, читатель может
 * дойти до источника сам, но пометка всё равно предупреждает, что это
 * не первичные данные.
 */
interface Props { href?: string }
const { href } = Astro.props;
---
{href ? (
  <a class="src2" href={href} target="_blank" rel="noopener"><slot /></a>
) : (
  <span class="src2"><slot /></span>
)}
