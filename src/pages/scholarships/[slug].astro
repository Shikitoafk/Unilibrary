---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Fact from '../../components/Fact.astro';
import Interp from '../../components/Interp.astro';
import Unknown from '../../components/Unknown.astro';
import Src from '../../components/Src.astro';
import { dateRu } from '../../lib/format';

export async function getStaticPaths() {
  return (await getCollection('scholarships')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const toc = [...entry.body!.matchAll(/<Section\s+num="([^"]+)"\s+id="([^"]+)"\s+title="([^"]+)"/g)]
  .map((m) => ({ num: m[1], id: m[2], title: m[3] }));
---
<Base title={`${d.name} — стипендия и разбор`} description={d.thesis} accent={d.accent} accentDark={d.accentDark}>
  <div class="shell">
    <header class="masthead">
      <p class="eyebrow"><a href="/">UniLibrary</a> · {d.country} · стипендиальная программа</p>
      <h1 class="uni-name">{d.name}</h1>
      <p class="thesis">{d.thesis}</p>
      <p class="cycle">{d.cycle}</p>
      <a class="download" href={d.pdf} download>Скачать полный разбор в PDF ↗</a>
      <p class="profile-note">Профиль: <b>{d.profile}</b>. Обновлено {dateRu(d.updated)}.</p>
    </header>
    <div class="toc-col">
      <nav class="toc" aria-label="Разделы стипендии">
        <div class="toc-title">В этом разборе</div>
        <ol>{toc.map((h) => <li><a href={`#${h.id}`}>{h.title}</a></li>)}</ol>
        <div class="toc-legend">
          <div class="leg"><b>Проверено</b>Есть официальный источник.</div>
          <div class="leg"><b>Из исследования</b>Материал авторского PDF.</div>
          <div class="leg"><b>Интерпретация</b>Оценка, а не обещание программы.</div>
          <div class="leg"><b>Не выяснено</b>Вопрос для уточнения.</div>
        </div>
      </nav>
    </div>
    <main class="uni-body"><Content components={{ Section, Fact, Interp, Unknown, Src }} /></main>
    <div class="sources" id="sources">
      <h2>Источники</h2>
      <ul>{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul>
      <p class="src-caveat">Основа — предоставленный автором PDF. Условия проверены для указанного набора. Отбор нового года, доступность программы и обязательства по договору проверяй отдельно.</p>
    </div>
  </div>
</Base>
<style>
  .cycle { color: var(--ink-soft); font-size: 13px; margin: 20px 0 14px; }
  .download { display: inline-block; padding: 12px 18px; border: 1px solid currentColor; color: var(--accent); text-decoration: none; font-weight: 600; }
  .download:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sources li { margin: 10px 0; overflow-wrap: anywhere; }
  @media print { .download { display: none; } }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copylink').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = new URL(location.href);
      url.hash = button.dataset.anchor ?? '';
      try {
        await navigator.clipboard.writeText(url.href);
        button.textContent = 'Скопировано';
        setTimeout(() => { button.textContent = 'Ссылка'; }, 1800);
      } catch {
        location.hash = url.hash;
      }
    });
  });
</script>
